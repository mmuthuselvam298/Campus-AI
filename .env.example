# ============================================================
# Campus Lost & Found AI - Environment Configuration
# ============================================================

# Vision AI Configuration (Google Gemini API)
# Get a key at: https://aistudio.google.com/app/apikey
# If left empty, the application will automatically run in honest manual fallback mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Backend Server & SQLite Storage Configuration
SERVER_PORT=8080
DATABASE_PATH=./data/campus_lost_found.db
UPLOAD_DIRECTORY=./uploads
FRONTEND_ORIGIN=http://localhost:5173

# Email & SMTP Delivery Configuration
# For local development without email delivery, keep MAIL_ENABLED=false.
# For production email delivery, set MAIL_ENABLED=true and provide SMTP credentials.
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=lostandfound@campus.edu

# Authentication & Access Controls
# Set to true for local testing without an email server.
# When true, the generated 6-digit OTP is returned to the frontend and printed to logs.
# When false (production), the OTP is never exposed in API responses or logs.
AUTH_DEV_OTP_ENABLED=true

# Optional comma-separated list of allowed campus email domains (e.g. campus.edu,univ.edu)
# Leave blank to allow any valid email
CAMPUS_EMAIL_DOMAINS=

# Comma-separated list of bootstrap administrator emails.
# When an email in this list signs up/verifies, they are immediately granted the ADMIN role.
INITIAL_ADMIN_EMAILS=admin@campus.edu
